# Local settings for tools/start_receiver.sh.  Copy to .env (ignored by git) and uncomment what
# differs from the reference rig.  Plain KEY=value lines; the file is sourced by bash.
#ADVERTISE_IP=192.168.2.1          # the receiver's IP on the controller's network
#DNS_UPSTREAM=192.168.1.1          # the real resolver the DNS sink forwards to
#CONTROLLER_IP=192.168.2.2        # reference controller address (log marking, advertise-ip detection)
#IFACE=bridge100                   # interface to capture on
#PCAP=0                            # skip the packet capture
#PCAP_FILTER="host 192.168.2.2"   # tcpdump filter (default: everything on IFACE, i.e. every controller)
#PYTHON=python3                    # interpreter (default: .venv/bin/python if present, else python3)
